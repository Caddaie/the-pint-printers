{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/gift-voucher-card.jpg",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/:dir+/index.html", "destination": "/:dir+", "permanent": true },
    { "source": "/:dir+/index", "destination": "/:dir+", "permanent": true },
    {
      "source": "/:name((?!google61623efbcbe62d9b\\.html$).*)\\.html",
      "destination": "/:name",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/:path((?:[^/]+/)*[^/.]+)", "destination": "/:path.html" },
    { "source": "/:path((?:[^/]+/)*[^/.]+)", "destination": "/:path/index.html" }
  ]
}
